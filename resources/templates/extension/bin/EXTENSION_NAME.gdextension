[configuration]

entry_symbol = "EXTENSION_NAME_init"
compatibility_minimum = "GOC_GODOTCPP_API_VERSION"
reloadable = false

[raries]
macos.single.debug = "./macos/EXTENSION_NAME.macos.template_debug.dy"
macos.double.debug = "./macos/EXTENSION_NAME.macos.template_debug.double.dy"
macos.single.release = "./macos/EXTENSION_NAME.macos.template_release.dy"
macos.double.release = "./macos/EXTENSION_NAME.macos.template_release.double.dy"

ios.arm64.single.debug = "./ios/EXTENSION_NAME.ios.template_debug.arm64.dy"
ios.arm64.double.debug = "./ios/EXTENSION_NAME.ios.template_debug.arm64.double.dy"
ios.arm64.single.release = "./ios/EXTENSION_NAME.ios.template_release.arm64.dy"
ios.arm64.double.release = "./ios/EXTENSION_NAME.ios.template_release.arm64.double.dy"

windows.x86_32.single.debug = "./windows/EXTENSION_NAME.windows.template_debug.x86_32.dll"
windows.x86_32.double.debug = "./windows/EXTENSION_NAME.windows.template_debug.x86_32.double.dll"
windows.x86_32.single.release = "./windows/EXTENSION_NAME.windows.template_release.x86_32.dll"
windows.x86_32.double.release = "./windows/EXTENSION_NAME.windows.template_release.x86_32.double.dll"

windows.x86_64.single.debug = "./windows/EXTENSION_NAME.windows.template_debug.x86_64.dll"
windows.x86_64.double.debug = "./windows/EXTENSION_NAME.windows.template_debug.x86_64.double.dll"
windows.x86_64.single.release = "./windows/EXTENSION_NAME.windows.template_release.x86_64.dll"
windows.x86_64.double.release = "./windows/EXTENSION_NAME.windows.template_release.x86_64.double.dll"

linux.x86_64.single.debug = "./linux/EXTENSION_NAME.linux.template_debug.x86_64.so"
linux.x86_64.double.debug = "./linux/EXTENSION_NAME.linux.template_debug.x86_64.double.so"
linux.x86_64.single.release = "./linux/EXTENSION_NAME.linux.template_release.x86_64.so"
linux.x86_64.double.release = "./linux/EXTENSION_NAME.linux.template_release.x86_64.double.so"

linux.arm64.single.debug = "./linux/EXTENSION_NAME.linux.template_debug.arm64.so"
linux.arm64.double.debug = "./linux/EXTENSION_NAME.linux.template_debug.arm64.double.so"
linux.arm64.single.release = "./linux/EXTENSION_NAME.linux.template_release.arm64.so"
linux.arm64.double.release = "./linux/EXTENSION_NAME.linux.template_release.arm64.double.so"

linux.rv64.single.debug = "./linux/EXTENSION_NAME.linux.template_debug.rv64.so"
linux.rv64.double.debug = "./linux/EXTENSION_NAME.linux.template_debug.rv64.double.so"
linux.rv64.single.release = "./linux/EXTENSION_NAME.linux.template_release.rv64.so"
linux.rv64.double.release = "./linux/EXTENSION_NAME.linux.template_release.rv64.double.so"

android.x86_64.single.debug = "./android/EXTENSION_NAME.android.template_debug.x86_64.so"
android.x86_64.double.debug = "./android/EXTENSION_NAME.android.template_debug.x86_64.double.so"
android.x86_64.single.release = "./android/EXTENSION_NAME.android.template_release.x86_64.so"
android.x86_64.double.release = "./android/EXTENSION_NAME.android.template_release.x86_64.double.so"

android.arm64.single.debug = "./android/EXTENSION_NAME.android.template_debug.arm64.so"
android.arm64.double.debug = "./android/EXTENSION_NAME.android.template_debug.arm64.double.so"
android.arm64.single.release = "./android/EXTENSION_NAME.android.template_release.arm64.so"
android.arm64.double.release = "./android/EXTENSION_NAME.android.template_release.arm64.double.so"

web.wasm32.single.debug = "./web/EXTENSION_NAME.web.template_debug.wasm32.nothreads.wasm"
web.wasm32.double.debug = "./web/EXTENSION_NAME.web.template_debug.wasm32.double.nothreads.wasm"
web.wasm32.single.release = "./web/EXTENSION_NAME.web.template_release.wasm32.nothreads.wasm"
web.wasm32.double.release = "./web/EXTENSION_NAME.web.template_release.wasm32.double.nothreads.wasm"